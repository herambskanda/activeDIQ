{
  "name": "@activediq/playwright-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright tooling: screenshots, E2E and demo recording (T-0011). Dev tooling only, never shipped.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "install-browsers": "playwright install chromium",
    "screenshot": "node screenshot.mjs",
    "record": "node record.mjs",
    "e2e": "playwright test --pass-with-no-tests",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
