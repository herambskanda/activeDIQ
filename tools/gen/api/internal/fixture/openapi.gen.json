    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Fixture API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/widgets": {
      "get": {
        "operationId": "listWidgets",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageCursor"
          },
          {
            "$ref": "#/components/parameters/PageLimit"
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/WidgetSortKey"
            }
          },
          {
            "in": "query",
            "name": "owner",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "modifiedSince",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "createdOn",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "active",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "id",
            "required": false,
            "schema": {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            }
          },
          {
            "in": "header",
            "name": "X-Request-Source",
            "required": false,
            "schema": {
              "maxLength": 32,
              "minLength": 3,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetPage"
                }
              }
            },
            "description": "A page of widgets",
            "headers": {
              "X-Total-Hint": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "summary": "List widgets (paths, query and header parameters, shared parameters, a response header)",
        "tags": [
          "widgets"
        ],
        "x-activediq-stability": "stable",
        "x-permission": "widgets.read"
      },
      "post": {
        "operationId": "createWidget",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WidgetCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            },
            "description": "Created",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "summary": "Create a widget (an object body with every scalar kind, an idempotency key)",
        "tags": [
          "widgets"
        ],
        "x-activediq-stability": "stable",
        "x-permission": "widgets.write"
      }
    },
    "/widgets/export": {
      "get": {
        "operationId": "exportWidgets",
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The export"
          }
        },
        "summary": "Export widgets as CSV (a binary response body)",
        "tags": [
          "widgets"
        ],
        "x-activediq-stability": "stable",
        "x-permission": "widgets.read"
      }
    },
    "/widgets/import": {
      "post": {
        "operationId": "importWidgets",
        "requestBody": {
          "content": {
            "text/csv": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            },
            "description": "The import result"
          },
          "400": {
            "$ref": "#/components/responses/MalformedRequest"
          }
        },
        "summary": "Import widgets from CSV (a binary request body)",
        "tags": [
          "widgets"
        ],
        "x-activediq-stability": "stable",
        "x-permission": "widgets.write"
      }
    },
    "/widgets/search": {
      "post": {
        "operationId": "searchWidgets",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WidgetSearch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetPage"
                }
              }
            },
            "description": "Matching widgets"
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "summary": "Search widgets (a bound safe-primitive wire form and a recursive discriminated union)",
        "tags": [
          "widgets"
        ],
        "x-activediq-limits": {
          "class": "read"
        },
        "x-activediq-stability": "stable",
        "x-permission": "widgets.read"
      }
    },
    "/widgets/{widgetId}": {
      "delete": {
        "operationId": "deleteWidget",
        "parameters": [
          {
            "in": "path",
            "name": "widgetId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "tags": [
          "widgets"
        ],
        "x-activediq-stability": "preview",
        "x-permission": "widgets.write"
      },
      "get": {
        "operationId": "getWidget",
        "parameters": [
          {
            "in": "path",
            "name": "widgetId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "expand",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            },
            "description": "The widget"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "tags": [
          "widgets"
        ],
        "x-activediq-stability": "stable",
        "x-permission": "widgets.read"
      },
      "patch": {
        "operationId": "updateWidget",
        "parameters": [
          {
            "in": "path",
            "name": "widgetId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "content": {
            "application/merge-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/WidgetPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            },
