          }
        },
        "required": [
          "filter"
        ],
        "type": "object",
        "x-activediq-tag": "widgets"
      },
      "WidgetSize": {
        "description": "A closed request enum used as a body member.",
        "enum": [
          "small",
          "large",
          "extra-large"
        ],
        "type": "string",
        "x-activediq-tag": "widgets"
      },
      "WidgetSortKey": {
        "description": "How a list is ordered. A request enum is closed.",
        "enum": [
          "name",
          "created",
          "modified"
        ],
        "type": "string",
        "x-activediq-tag": "widgets"
      },
      "WidgetStatus": {
        "description": "A response enum is open; clients accept values they do not know.",
        "enum": [
          "draft",
          "live",
