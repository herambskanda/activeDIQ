{
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "description": "Makes a mutating bulk call safe to retry. The same key with a different body is refused.",
        "in": "header",
        "name": "Idempotency-Key",
        "required": false,
        "schema": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "type": "string"
        }
      },
      "IfMatch": {
        "description": "The ETag of the version being changed; a stale value answers precondition-failed.",
        "in": "header",
        "name": "If-Match",
        "required": false,
        "schema": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "PageCursor": {
        "description": "The nextCursor of the previous page.",
        "in": "query",
        "name": "cursor",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/Cursor"
        }
      },
      "PageLimit": {
        "description": "The page size.",
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "responses": {
      "MalformedRequest": {
        "content": {
          "application/problem+json": {
            "example": {
              "status": 400,
              "title": "The request is malformed",
              "type": "/problems/malformed-request"
            },
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The request is malformed"
      },
      "NotFound": {
        "content": {
          "application/problem+json": {
            "example": {
              "status": 404,
              "title": "Not found",
              "type": "/problems/not-found"
            },
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Not found"
      },
      "Validation": {
        "content": {
          "application/problem+json": {
            "example": {
              "status": 400,
              "title": "The request is invalid",
              "type": "/problems/validation"
            },
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The request is invalid"
      }
    },
    "schemas": {
      "Cursor": {
        "description": "An opaque page cursor. Clients pass it back unchanged.",
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "FilterAst": {
        "additionalProperties": false,
        "description": "A stand-in for a safe-primitive wire form. The binding table maps it to the primitive's own type.",
        "properties": {
          "op": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "ImportResult": {
        "properties": {
          "imported": {
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "imported"
        ],
        "type": "object",
        "x-activediq-tag": "widgets"
      },
      "Int64String": {
        "description": "A 64-bit integer carried as a string, for values outside JavaScript's safe integer range.",
        "examples": [
          "9007199254740993"
        ],
        "maxLength": 20,
        "pattern": "^-?[0-9]{1,19}$",
        "type": "string"
      },
      "Labels": {
        "additionalProperties": {
          "maxLength": 16,
          "type": "string"
        },
        "description": "A map with a value schema, a property cap and no properties.",
        "maxProperties": 4,
        "type": "object",
        "x-activediq-tag": "widgets"
      },
      "PageInfo": {
        "description": "Cursor paging of a directory collection. Order is stable; nextCursor is null on the last page.",
        "properties": {
          "nextCursor": {
            "maxLength": 1024,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "nextCursor"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "An RFC 9457 problem. type is a relative reference, /problems/<slug>, from a closed catalogue.",
        "properties": {
          "code": {
            "maxLength": 100,
            "type": "string"
          },
          "detail": {
            "maxLength": 2048,
            "type": "string"
          },
          "directory": {
            "$ref": "#/components/schemas/ProblemDirectory"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemError"
            },
            "maxItems": 1000,
            "type": "array"
          },
          "instance": {
            "maxLength": 2048,
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "maxLength": 200,
            "type": "string"
          },
          "traceId": {
            "maxLength": 64,
            "type": "string"
          },
          "type": {
            "maxLength": 100,
            "pattern": "^/problems/[a-z][a-z0-9-]*$",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "ProblemDirectory": {
        "description": "The directory's own result, with secrets stripped. Never raw LDAP text with internals.",
        "properties": {
          "diagnostic": {
            "maxLength": 512,
            "type": "string"
          },
          "resultCode": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "resultCode",
          "diagnostic"
        ],
        "type": "object"
      },
      "ProblemError": {
        "description": "One violation. pointer is a JSON Pointer inside the body, or the parameter name.",
        "properties": {
          "code": {
            "maxLength": 64,
            "type": "string"
          },
          "detail": {
            "maxLength": 512,
            "type": "string"
          },
          "in": {
            "$ref": "#/components/schemas/ProblemErrorIn"
          },
          "item": {
            "description": "For a bulk request, the index of the item the violation belongs to.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "pointer": {
            "maxLength": 1024,
            "type": "string"
          }
        },
        "required": [
          "in",
          "pointer",
          "code",
          "detail"
        ],
        "type": "object"
      },
      "ProblemErrorIn": {
        "description": "Where a violation was found.",
        "enum": [
          "body",
          "path",
          "query",
          "header"
        ],
        "type": "string",
        "x-activediq-enum": "open"
      },
      "Rule": {
        "description": "A recursive discriminated union on kind.",
        "discriminator": {
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/RuleAnd"
          },
          {
            "$ref": "#/components/schemas/RuleOr"
          },
          {
            "$ref": "#/components/schemas/RuleNot"
          },
          {
            "$ref": "#/components/schemas/RuleEquals"
          }
        ],
        "x-activediq-tag": "widgets"
      },
      "RuleAnd": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "and",
            "type": "string"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/Rule"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "kind",
          "rules"
        ],
        "type": "object",
        "x-activediq-tag": "widgets"
      },
      "RuleEquals": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "maxLength": 32,
            "type": "string"
          },
          "kind": {
            "const": "equals",
            "type": "string"
          },
          "value": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "field",
          "value"
        ],
        "type": "object",
        "x-activediq-tag": "widgets"
      },
      "RuleNot": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "not",
            "type": "string"
          },
          "rule": {
            "$ref": "#/components/schemas/Rule"
          }
        },
        "required": [
          "kind",
          "rule"
        ],
        "type": "object",
        "x-activediq-tag": "widgets"
      },
      "RuleOr": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "or",
            "type": "string"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/Rule"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "kind",
          "rules"
        ],
        "type": "object",
        "x-activediq-tag": "widgets"
      },
      "SecretInput": {
        "description": "A secret a client sends: a password, a token. It is write-only, never appears in a response, and is held in memory only as a secret.Secret that is destroyed after the request.",
        "type": "string",
        "writeOnly": true,
        "x-activediq-secret": true
      },
      "Tags": {
        "description": "A named array.",
        "items": {
          "maxLength": 16,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "maxItems": 8,
        "minItems": 0,
        "type": "array",
        "x-activediq-tag": "widgets"
      },
      "Widget": {
        "description": "A widget as the server shows it.",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "expires": {
            "format": "date",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "labels": {
            "$ref": "#/components/schemas/Labels"
          },
          "name": {
            "maxLength": 32,
            "type": "string"
          },
          "notes": {
            "maxLength": 64,
            "type": [
              "string",
              "null"
            ]
          },
          "quota": {
            "$ref": "#/components/schemas/Int64String"
          },
          "status": {
            "$ref": "#/components/schemas/WidgetStatus"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "quota",
          "notes",
          "createdAt"
        ],
        "type": "object",
        "x-activediq-tag": "widgets"
      },
      "WidgetCreate": {
        "additionalProperties": false,
        "description": "A request object, every optional and required form.",
        "properties": {
          "contact": {
            "format": "email",
            "type": "string"
          },
          "count": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          },
          "expires": {
            "format": "date",
            "type": "string"
          },
          "labels": {
            "$ref": "#/components/schemas/Labels"
          },
          "name": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "notes": {
            "maxLength": 64,
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "format": "uuid",
            "type": "string"
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/WidgetPart"
            },
            "maxItems": 3,
            "type": "array"
          },
          "quota": {
            "$ref": "#/components/schemas/Int64String"
          },
          "size": {
            "$ref": "#/components/schemas/WidgetSize"
          },
          "starts": {
            "format": "date-time",
            "type": "string"
          },
          "tags": {
            "$ref": "#/components/schemas/Tags"
          }
        },
        "required": [
          "name",
          "size",
          "owner",
          "notes",
          "quota"
        ],
        "type": "object",
        "x-activediq-tag": "widgets"
      },
      "WidgetCredential": {
        "additionalProperties": false,
        "description": "A request that carries secrets.",
        "properties": {
          "backup": {
            "$ref": "#/components/schemas/SecretInput"
          },
          "extra": {
            "items": {
              "$ref": "#/components/schemas/SecretInput"
            },
            "maxItems": 4,
            "type": "array"
          },
          "hint": {
            "maxLength": 32,
            "type": "string"
          },
          "secret": {
            "$ref": "#/components/schemas/SecretInput"
          }
        },
        "required": [
          "secret"
        ],
        "type": "object",
        "x-activediq-tag": "widgets"
      },
      "WidgetPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Widget"
            },
            "maxItems": 1000,
            "type": "array"
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "items",
          "page"
        ],
        "type": "object",
        "x-activediq-tag": "widgets"
      },
      "WidgetPart": {
        "additionalProperties": false,
