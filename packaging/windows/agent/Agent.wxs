<?xml version="1.0" encoding="utf-8"?>
<!--
  activeDIQ agent MSI (T-0555, ADR-0006). WiX Toolset v4 syntax. NOT BUILT OR INSTALLED in the
  authoring environment (no Windows lab): every element is [UNVERIFIED — lab] until fitness-agent-host
  and the Windows lab items of the ticket run. The A1 check (tools/fitness/agenthost) reads this file.

  Identity: the service runs as the virtual account NT SERVICE\activeDIQAgent with a RESTRICTED service
  SID and one privilege, SeChangeNotifyPrivilege. Never a shared service identity, never a domain
  account. Read access to the Security channel is a channel ACE written by agentsetup (fail-closed);
  no Active Directory object is created or changed.
  No inbound firewall exception is installed: the agent has no listener and only dials out.
  No reboot is requested.
  Flow: install starts the service UNENROLLED; it idles (event 103, warning) and picks up `agent enroll`
  within a few seconds (polls every 5 s, T-0813/T-1249).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="activeDIQ Agent" Manufacturer="skenzeriq" Version="$(var.Version)" UpgradeCode="6f3b8c1e-5d1a-4f6e-9a57-3c2b7d0e4a11" Scope="perMachine" InstallerVersion="500">
    <!-- afterInstallInitialize puts removal of the old product inside the install transaction, so a failed
         upgrade rolls back to the old version. The default (afterInstallValidate) removes it first and
         leaves a failed upgrade with no agent installed (T-0648, lab: forced failure -> no product). -->
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer activeDIQ Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="REBOOT" Value="ReallySuppress" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="VendorDir" Name="skenzeriq">
        <Directory Id="AgentDir" Name="agent" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AgentFiles" Directory="AgentDir">
      <Component Id="AgentExe" Guid="*">
        <File Id="AgentExeFile" Source="$(var.AgentExe)" Name="activediq-agent.exe" KeyPath="yes" />
        <ServiceInstall Id="AgentService" Name="activeDIQAgent" DisplayName="activeDIQ Agent"
                        Description="Collects domain controller audit events and applies signed activeDIQ policy."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Vital="yes"
                        Account="NT SERVICE\activeDIQAgent">
          <!-- Restricted service SID and exactly one privilege, declared here and never through the
               registry (T-0688 ruling 4b). The built MSI carries MsiServiceConfig ConfigType 5 (SID, 3) and 6
               (privileges) rows, checked by fitness-built-msi and read back by T-0648. -->
          <ServiceConfig ServiceSid="restricted" OnInstall="yes" OnReinstall="yes">
            <RequiredPrivilege Name="SeChangeNotifyPrivilege" />
          </ServiceConfig>
        </ServiceInstall>
        <!-- Start="install" is safe since T-0813: an unenrolled agent idles (event 103) instead of exiting, so the
             install no longer races into error 1920. It picks up `agent enroll` within a few seconds. -->
        <ServiceControl Id="AgentServiceControl" Name="activeDIQAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="SetupExe" Guid="*">
        <File Id="SetupExeFile" Source="$(var.SetupExe)" Name="agentsetup.exe" KeyPath="yes" />
        <!-- agent.json is written by the WriteConfig custom action, so Windows Installer does not know it;
             without these the uninstall leaves it and both folders behind (T-0648, lab). It is always
             rewritten at install, so removing it on upgrade loses nothing. -->
        <RemoveFile Id="RemoveAgentJson" Directory="AgentDir" Name="agent.json" On="uninstall" />
        <RemoveFolder Id="RemoveAgentDir" Directory="AgentDir" On="uninstall" />
        <RemoveFolder Id="RemoveVendorDir" Directory="VendorDir" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- Custom actions run agentsetup with fixed arguments; nothing is interpolated and no PowerShell
         is involved. Install-time actions fail closed (Return="check"). -->
    <CustomAction Id="WriteConfig" Directory="AgentDir" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[AgentDir]agentsetup.exe&quot; write-config" />
    <CustomAction Id="PrepareDataDir" Directory="AgentDir" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[AgentDir]agentsetup.exe&quot; prepare-datadir" />
    <CustomAction Id="GrantChannel" Directory="AgentDir" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[AgentDir]agentsetup.exe&quot; grant-channel" />
    <CustomAction Id="RollbackGrantChannel" Directory="AgentDir" Execute="rollback" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[AgentDir]agentsetup.exe&quot; revoke-channel" />
    <CustomAction Id="RevokeChannel" Directory="AgentDir" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[AgentDir]agentsetup.exe&quot; revoke-channel" />

    <!-- Service recovery (restart x3) and the Application event source are set by agentsetup, not by WiX: the
         core ServiceConfigFailureActions of WiX 5.0.2 fails the install (error 1939, lab) and the util
         extension adds a DLL custom action, a Binary row and HKLM\SYSTEM registry rows, all refused by
         fitness-built-msi (T-0724). Rolling back or uninstalling removes the event source only. -->
    <CustomAction Id="ConfigureService" Directory="AgentDir" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[AgentDir]agentsetup.exe&quot; configure-service" />
    <CustomAction Id="RollbackConfigureService" Directory="AgentDir" Execute="rollback" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[AgentDir]agentsetup.exe&quot; unconfigure-service" />
    <CustomAction Id="UnconfigureService" Directory="AgentDir" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[AgentDir]agentsetup.exe&quot; unconfigure-service" />

    <InstallExecuteSequence>
      <Custom Action="WriteConfig" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RollbackGrantChannel" Before="GrantChannel" Condition="NOT REMOVE" />
      <!-- PrepareDataDir and GrantChannel resolve NT SERVICE\activeDIQAgent to a SID, which Windows only
           does once the service exists, so both run after InstallServices (T-0648: before it,
           PrepareDataDir failed with "No mapping between account names and security IDs"). -->
      <Custom Action="PrepareDataDir" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="GrantChannel" After="PrepareDataDir" Condition="NOT REMOVE" />
      <!-- The service exists after InstallServices; the rollback entry is skipped on an upgrade so a failed
           upgrade does not unregister the event source of the version that is kept. -->
      <Custom Action="RollbackConfigureService" Before="ConfigureService" Condition="NOT REMOVE AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="ConfigureService" After="GrantChannel" Condition="NOT REMOVE" />
      <Custom Action="RevokeChannel" Before="StopServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <!-- After RevokeChannel, which logs to the source if the revoke fails. -->
      <Custom Action="UnconfigureService" After="RevokeChannel" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="activeDIQ Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
    </Feature>
  </Package>
</Wix>
