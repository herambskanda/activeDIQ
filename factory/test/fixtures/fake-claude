#!/usr/bin/env node
// A stand-in for `claude -p … --output-format stream-json`. Behaviour is chosen with FAKE_CLAUDE_MODE:
//   advance (default)  work, then run `factory ticket advance` for FACTORY_TICKET
//   reject             as advance, but `factory ticket reject`
//   noop               claim success without touching the ticket
//   ratelimit          fail with a usage-limit error
//   hang               run until killed (FAKE_IGNORE_TERM=1 ignores SIGTERM)
// FAKE_CLAUDE_COMMIT=<file> also writes and commits that file in the working directory
// (only for FAKE_CLAUDE_COMMIT_ROLE, when set).
import fs from 'node:fs';
import path from 'node:path';
import { execFileSync } from 'node:child_process';

const args = process.argv.slice(2);
const ticket = process.env.FACTORY_TICKET;
if (!ticket) process.exit(0); // not launched by the dispatcher (e.g. found by a test runner): do nothing

const role = process.env.FACTORY_ROLE;
const mode = process.env.FAKE_CLAUDE_MODE || 'advance';
const emit = (o) => process.stdout.write(`${JSON.stringify(o)}\n`);
const session = `sess-${process.env.FACTORY_RUN_ID}`;
if (process.env.FAKE_CLAUDE_ARGS_LOG) {
  fs.appendFileSync(process.env.FAKE_CLAUDE_ARGS_LOG, `${JSON.stringify({ args, cwd: process.cwd(), role, ticket, run: process.env.FACTORY_RUN_ID })}\n`);
}

emit({ type: 'system', subtype: 'hook_started', hook_name: 'SessionStart' });
emit({ type: 'system', subtype: 'init', model: 'claude-sonnet-5-5', session_id: session });
emit({
  type: 'assistant',
  message: {
    model: 'claude-sonnet-5-5',
    content: [{ type: 'text', text: `Working on ${ticket} as ${role}` }, { type: 'tool_use', name: 'Bash', input: { command: 'ls -la' } }],
    usage: { input_tokens: 2, cache_creation_input_tokens: 2167, cache_read_input_tokens: 5982, output_tokens: 526 },
  },
  session_id: session,
});

const result = (text, isError = false) => emit({
  type: 'result', subtype: isError ? 'error_during_execution' : 'success', is_error: isError, num_turns: 3,
  total_cost_usd: 0.07, result: text, session_id: session, usage: {}, modelUsage: { 'claude-sonnet-5-5': { contextWindow: 1000000 } },
});
const factory = (...a) => execFileSync(process.execPath, [process.env.FAKE_CLAUDE_FACTORY_BIN, ...a], { encoding: 'utf8', env: process.env });

if (mode === 'hang') {
  process.on('SIGTERM', () => { if (!process.env.FAKE_IGNORE_TERM) process.exit(143); });
  setInterval(() => {}, 1000);
} else if (mode === 'ratelimit') {
  result("You've hit your usage limit. Your limit resets at 5pm.", true);
  process.exit(1);
} else if (mode === 'noop') {
  result('Looked around.\nRESULT: advanced — nothing really');
} else {
  if (process.env.FAKE_CLAUDE_COMMIT && (!process.env.FAKE_CLAUDE_COMMIT_ROLE || process.env.FAKE_CLAUDE_COMMIT_ROLE === role)) {
    const git = (...a) => execFileSync('git', a, { cwd: process.cwd(), stdio: 'ignore' });
    fs.writeFileSync(path.join(process.cwd(), process.env.FAKE_CLAUDE_COMMIT), `${ticket} by ${role}\n`);
    git('add', '-A');
    git('-c', 'user.name=Fake', '-c', 'user.email=fake@example.com', 'commit', '-q', '-m', `feat: work for ${ticket}`);
  }
  const verb = mode === 'reject' ? 'reject' : 'advance';
  factory('ticket', verb, ticket, '--by', role, '--note', `${verb} by fake claude`);
  result(`Finished.\nRESULT: ${verb === 'reject' ? 'rejected' : 'advanced'} — fake ${verb}`);
}
