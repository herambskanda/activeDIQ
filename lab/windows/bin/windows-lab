#!/usr/bin/env bash
# Windows Server 2025 evaluation lab on local KVM/libvirt (T-0254, D-0003 option a).
# One DC (dc1) + one member/file server (fs1) in a throwaway domain win.activediq.test.
# Runbook: knowledge/development/runbooks/windows-lab.md
# Subcommands: preflight | up | reset | down | destroy | status | info | test-connector
# External mode (T-0428): WIN_LAB_MODE=external targets a DC someone else provides (e.g. Proxmox VM 112) instead of
# local libvirt. Needs WIN_LAB_DC_ADDR (IP/host), WIN_LAB_TLS_NAME (name in the DC cert), WIN_LAB_CA (root CA PEM),
# WIN_LAB_ENV (credentials file, mode 0600). Only preflight|status|info|test-connector work; nothing calls virsh.
# test-connector runs under bin/with-dc1-lock (one dc1 session at a time, T-0839).
# WIN_LAB_DRYRUN=1 prints every external command instead of running it (used by the offline test).
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
STATE="${WIN_LAB_STATE:-$HERE/.state}"            # gitignored: disks, ISOs, generated secrets
ENVF="${WIN_LAB_ENV:-$HERE/.win-lab.env}"          # gitignored, mode 0600: generated credentials
CAF="${WIN_LAB_CA:-$HERE/.win-lab-ca.pem}"         # gitignored: DC root CA (public cert)
LOGDIR="${WIN_LAB_LOGDIR:-$HERE/../../knowledge/development/runbooks/windows-lab-runs}"  # run logs live beside the runbook (no secrets are ever logged)
URI="${WIN_LAB_URI:-qemu:///system}"
NET=diq-win-lab; SUBNET=192.168.77; DC_IP=$SUBNET.10; FS_IP=$SUBNET.11
DOMAIN=win.activediq.test; NETBIOS=WINLAB; BASEDN="DC=win,DC=activediq,DC=test"
DC_VM=diq-win-dc1; FS_VM=diq-win-fs1; SNAP=clean
DISK_GB="${WIN_LAB_DISK_GB:-48}"; RAM_MB="${WIN_LAB_RAM_MB:-4096}"; CPUS="${WIN_LAB_CPUS:-2}"
# [UNVERIFIED] Microsoft evaluation-centre link; override with WIN_LAB_ISO_URL (or drop the ISO at $ISO) if it moved.
ISO_URL="${WIN_LAB_ISO_URL:-https://go.microsoft.com/fwlink/?linkid=2293312&clcid=0x409&culture=en-us&country=us}"
ISO="${WIN_LAB_ISO:-$STATE/ws2025-eval.iso}"
WAIT="${WIN_LAB_WAIT_SECS:-5400}"
MIN_FREE_GB="${WIN_LAB_MIN_FREE_GB:-45}"  # the stubbed unit tests pin this so they do not depend on the host disk
DRY="${WIN_LAB_DRYRUN:-}"
MODE="${WIN_LAB_MODE:-local}"
GO="${WIN_LAB_GO:-go}"

die() { echo "windows-lab: $*" >&2; exit 1; }
run() { if [ "$DRY" = 1 ]; then echo "+ $*"; else "$@"; fi; }
virsh_() { [ "$MODE" = external ] && die "internal error: virsh in external mode"; run virsh -c "$URI" "$@"; }
case "$MODE" in
  local) ;;
  external)
    DC_IP="${WIN_LAB_DC_ADDR:-}"; TLS_NAME="${WIN_LAB_TLS_NAME:-dc1.$DOMAIN}"
    export WIN_LAB_DC_ADDR="$DC_IP" WIN_LAB_TLS_NAME="$TLS_NAME" ;;
  *) die "WIN_LAB_MODE must be 'local' or 'external' (got '$MODE')";;
esac
mac() { printf '52:54:00:77:00:%02x' "${1##*.}"; }

preflight() {
  local miss=0 t
  for t in virsh virt-install qemu-img xorriso curl openssl nc python3; do
    command -v "$t" >/dev/null 2>&1 || { echo "missing: $t"; miss=1; }
  done
  [ -e /dev/kvm ] || { echo "missing: /dev/kvm (enable VT-x/AMD-V; join group kvm)"; miss=1; }
  if [ "$miss" = 1 ]; then
    echo "install (Debian/Ubuntu): sudo apt install qemu-kvm libvirt-daemon-system libvirt-clients virtinst ovmf xorriso netcat-openbsd" >&2
    [ "$DRY" = 1 ] || exit 1
  fi
  mkdir -p "$STATE" "$LOGDIR"
  # thin-provisioned qcow2: ~15 GB real use per VM after install; require headroom for 2 VMs + ISO + snapshots
  local free; free=$(df -Pk "$STATE" | awk 'NR==2{print int($4/1048576)}')
  [ "$free" -ge "$MIN_FREE_GB" ] || [ "$DRY" = 1 ] || die "need >= ${MIN_FREE_GB} GB free in $STATE (have ${free} GB)"
}

# Random per-lab credentials; never printed, never committed.
mkenv() {
  [ -f "$ENVF" ] && return 0
  ( umask 077
    pw() { printf 'Wl-%s-aA1!' "$(openssl rand -hex 14)"; }
    {
      echo "WIN_LAB_ID=$(openssl rand -hex 6)"
      echo "WIN_LAB_ADMIN_PASSWORD=$(pw)"   # Administrator, provisioning only
      echo "WIN_LAB_DSRM_PASSWORD=$(pw)"
      echo "WIN_LAB_SVC_PASSWORD=$(pw)"     # svc-activediq, delegated; used by connector tests
      echo "WIN_LAB_USER_PASSWORD=$(pw)"
    } > "$ENVF" )
  echo ">> generated $ENVF (random, mode 0600, gitignored)"
}

fetch_iso() {
  [ -f "$ISO" ] && return 0
  echo ">> downloading the Windows Server 2025 evaluation ISO (~5 GB, free, 180-day licence)"
  run curl -fL --retry 3 -C - -o "$ISO.part" "$ISO_URL"
  if [ "$DRY" != 1 ]; then
    local sum; sum=$(sha256sum "$ISO.part" | cut -d' ' -f1)
    if [ -n "${WIN_LAB_ISO_SHA256:-}" ] && [ "$sum" != "$WIN_LAB_ISO_SHA256" ]; then rm -f "$ISO.part"; die "ISO sha256 mismatch ($sum)"; fi
    mv "$ISO.part" "$ISO"; echo "$sum  ws2025-eval.iso" > "$ISO.sha256"
    echo ">> ISO sha256 $sum (recorded beside the ISO; pin it with WIN_LAB_ISO_SHA256 for later rebuilds)"
  fi
}

# Per-VM config CD: autounattend.xml + guest scripts + lab.json (secrets). Lives only in $STATE, built 0600.
mkcfg() {  # name role ip
  local name=$1 role=$2 ip=$3 d="$STATE/cfg-$1" cn=DC1
  [ "$role" = dc ] || cn=FS1
  rm -rf "$d"; mkdir -p "$d"
  cp "$HERE"/guest/*.ps1 "$d/"
  sed -e "s/@@COMPUTERNAME@@/$cn/" "$HERE/guest/autounattend.xml.tmpl" > "$d/autounattend.xml.pre"
  ( umask 077
    set -a; . "$ENVF"; set +a
    python3 -I - "$d" "$role" "$ip" "$DOMAIN" "$NETBIOS" "$DC_IP" "$BASEDN" <<'PY'
import json, os, sys
from xml.sax.saxutils import escape
d, role, ip, domain, nb, dcip, basedn = sys.argv[1:8]
pw = os.environ["WIN_LAB_ADMIN_PASSWORD"]
x = open(d + "/autounattend.xml.pre").read().replace("@@ADMINPW@@", escape(pw))
open(d + "/autounattend.xml", "w").write(x); os.remove(d + "/autounattend.xml.pre")
json.dump({"role": role, "ip": ip, "domain": domain, "netbios": nb, "dcIp": dcip, "baseDn": basedn,
           "adminPassword": pw, "dsrmPassword": os.environ["WIN_LAB_DSRM_PASSWORD"],
           "svcPassword": os.environ["WIN_LAB_SVC_PASSWORD"], "userPassword": os.environ["WIN_LAB_USER_PASSWORD"]},
          open(d + "/lab.json", "w"))
os.chmod(d + "/lab.json", 0o600); os.chmod(d + "/autounattend.xml", 0o600)
PY
  )
  run xorriso -as mkisofs -quiet -V CIDATA -J -r -o "$STATE/cfg-$name.iso" "$d"
  chmod 600 "$STATE/cfg-$name.iso" 2>/dev/null || true
  rm -rf "$d"
}

mknet() {
  if [ "$DRY" != 1 ] && virsh -c "$URI" net-info "$NET" >/dev/null 2>&1; then return 0; fi
  local x="$STATE/net.xml"
  printf "<network><name>%s</name><forward mode='nat'/><bridge name='virbr-diqwin'/><domain name='%s' localOnly='yes'/><ip address='%s.1' netmask='255.255.255.0'/></network>\n" \
    "$NET" "$DOMAIN" "$SUBNET" > "$x"
  virsh_ net-define "$x"; virsh_ net-start "$NET"; virsh_ net-autostart "$NET"
}

mkvm() {  # name role ip
  local name=$1 role=$2 ip=$3 disk="$STATE/$1.qcow2"
  mkcfg "$name" "$role" "$ip"
  run qemu-img create -f qcow2 "$disk" "${DISK_GB}G" >/dev/null     # thin provisioned
  run virt-install --connect "$URI" --name "$name" --memory "$RAM_MB" --vcpus "$CPUS" --cpu host-passthrough \
    --osinfo detect=on,name=win2k25 --boot uefi \
    --disk "path=$disk,bus=sata" --disk "path=$ISO,device=cdrom" --disk "path=$STATE/cfg-$name.iso,device=cdrom" \
    --network "network=$NET,model=e1000e,mac=$(mac "$ip")" --graphics none --noautoconsole --sound none
}

wait_port() {  # ip port label
  local t=0
  if [ "$DRY" = 1 ]; then echo "+ wait $1:$2 ($3)"; return 0; fi
  until nc -z -w 3 "$1" "$2" 2>/dev/null; do
    sleep 20; t=$((t+20)); [ "$t" -lt "$WAIT" ] || die "timeout waiting for $3 ($1:$2)"
  done
}

export_ca() {  # trust anchor = the root CA that guest/dc.ps1 created and that issued dc1's LDAPS certificate
  if [ -n "${WIN_LAB_SKIP_CA:-}" ]; then return 0; fi   # test seam: the offline test pre-places the CA
  if [ "$DRY" = 1 ]; then echo "+ export lab root CA from dc1:636 -> $CAF"; return 0; fi
  openssl s_client -connect "$DC_IP:636" -servername "dc1.$DOMAIN" -showcerts </dev/null 2>/dev/null > "$STATE/chain.txt" || true
  awk 'BEGIN{RS="-----END CERTIFICATE-----"} /BEGIN CERTIFICATE/{sub(/.*-----BEGIN CERTIFICATE-----/,"-----BEGIN CERTIFICATE-----"); c=$0 "-----END CERTIFICATE-----\n"} END{printf "%s", c}' "$STATE/chain.txt" > "$CAF"
  openssl x509 -in "$CAF" -noout -subject >/dev/null || die "could not read the lab root CA from dc1"
}

up() {
  preflight; mkenv; fetch_iso; mknet
  if [ "$DRY" != 1 ] && virsh -c "$URI" dominfo "$DC_VM" >/dev/null 2>&1; then
    echo ">> VMs already exist — starting them (use 'reset' for the clean snapshot, 'destroy' to rebuild)"
    virsh -c "$URI" start "$DC_VM" 2>/dev/null || true; virsh -c "$URI" start "$FS_VM" 2>/dev/null || true
    wait_port $DC_IP 636 "dc1 LDAPS"; info; return 0
  fi
  local t0; t0=$(date +%s)
  mkvm "$DC_VM" dc "$DC_IP"
  wait_port $DC_IP 636 "dc1 LDAPS (install + promotion take ~35 min)"
  mkvm "$FS_VM" member "$FS_IP"
  wait_port $FS_IP 445 "fs1 SMB (domain join)"
  wait_port $FS_IP 5986 "fs1 WinRM-HTTPS"
  export_ca
  # clean snapshots, taken with the guests shut down so a revert is crash-consistent
  local v i
  for v in "$DC_VM" "$FS_VM"; do virsh_ shutdown "$v"; done
  if [ "$DRY" != 1 ]; then for v in "$DC_VM" "$FS_VM"; do
    for i in $(seq 60); do [ "$(virsh -c "$URI" domstate "$v")" = "shut off" ] && break; sleep 5; done; done; fi
  for v in "$DC_VM" "$FS_VM"; do virsh_ snapshot-create-as "$v" "$SNAP" --description "clean provisioned lab"; done
  for v in "$DC_VM" "$FS_VM"; do virsh_ start "$v"; done
  wait_port $DC_IP 636 "dc1 LDAPS after snapshot"
  echo "windows-lab up finished in $(( $(date +%s) - t0 ))s"; info
}

reset() {  # revert both VMs to the clean snapshot
  preflight
  local v
  for v in "$DC_VM" "$FS_VM"; do virsh_ snapshot-revert "$v" "$SNAP" --running; done
  wait_port $DC_IP 636 "dc1 LDAPS after revert"; wait_port $FS_IP 445 "fs1 SMB after revert"
  echo "windows-lab reset to snapshot '$SNAP'"
}

down() { local v; for v in "$FS_VM" "$DC_VM"; do virsh_ shutdown "$v" || true; done; }

destroy() {
  local v
  for v in "$FS_VM" "$DC_VM"; do
    virsh_ destroy "$v" 2>/dev/null || true
    virsh_ undefine "$v" --nvram --snapshots-metadata 2>/dev/null || true
  done
  virsh_ net-destroy "$NET" 2>/dev/null || true; virsh_ net-undefine "$NET" 2>/dev/null || true
  # the ISO is kept (5 GB download); disks, config CDs and credentials go
  run rm -f "$STATE"/*.qcow2 "$STATE"/cfg-*.iso "$STATE"/net.xml "$STATE"/chain.txt "$ENVF" "$CAF"
}

info() {
  if [ "$MODE" = external ]; then
    echo "Windows lab (external host): $DC_IP  ldaps://$DC_IP:636  TLS name $TLS_NAME  CA $CAF  credentials $ENVF"
    echo "  snapshot/revert is done in Proxmox by a human: runbook windows-lab.md, 'Prepare VM 112'"
    return 0
  fi
  echo "Windows lab: domain $DOMAIN ($NETBIOS)  base DN $BASEDN"
  echo "  dc1  $DC_IP  ldaps://$DC_IP:636 (cert name dc1.$DOMAIN; add '$DC_IP dc1.$DOMAIN' to /etc/hosts)"
  echo "  fs1  $FS_IP  SMB 445, WinRM-HTTPS 5986"
  echo "  credentials: $ENVF (mode 0600; svc-activediq@$DOMAIN = WIN_LAB_SVC_PASSWORD)   CA: $CAF"
  echo "  eval licence: 180 days from first boot; do not rearm — 'destroy' then 'up' rebuilds (~45 min)"
}

status() {
  if [ "$MODE" = external ]; then info; return 0; fi
  virsh -c "$URI" list --all 2>/dev/null | grep -E "diq-win|Name" || echo "no windows lab VMs"
  if [ -f "$ENVF" ]; then info; fi
}

# External mode: validate configuration before anything touches the network. Secrets are only ever read from files.
check_external() {
  [ -n "$DC_IP" ] || die "external mode: set WIN_LAB_DC_ADDR (DC IP or host name)"
  [[ "$DC_IP" =~ ^[A-Za-z0-9]([A-Za-z0-9.:-]*[A-Za-z0-9])?$ ]] || die "external mode: WIN_LAB_DC_ADDR is not a plain IP/host name"
  [[ "$TLS_NAME" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || die "external mode: WIN_LAB_TLS_NAME is not a plain DNS name"
  [ -f "$CAF" ] || die "external mode: CA file not found: $CAF (WIN_LAB_CA; export it per the runbook, section 'Prepare VM 112')"
  [ -f "$ENVF" ] || die "external mode: credentials file not found: $ENVF (WIN_LAB_ENV)"
  local m; m=$(stat -c %a "$ENVF")
  case "$m" in 400|600) ;; *) die "external mode: $ENVF must be mode 0600 (is $m): chmod 600 it";; esac
  grep -q '^WIN_LAB_SVC_PASSWORD=' "$ENVF" || die "external mode: $ENVF has no WIN_LAB_SVC_PASSWORD"
}

test_connector() {
  if [ "$MODE" = external ]; then
    check_external
    # absolute paths: go test runs in the package directory
    export WIN_LAB_CA; WIN_LAB_CA="$(cd "$(dirname "$CAF")" && pwd)/$(basename "$CAF")"
    export WIN_LAB_ENV; WIN_LAB_ENV="$(cd "$(dirname "$ENVF")" && pwd)/$(basename "$ENVF")"
    echo ">> external mode: $DC_IP:636, TLS name $TLS_NAME, certificate verification ON"
  fi
  [ -f "$ENVF" ] && [ -f "$CAF" ] || die "lab not up: run make windows-lab-up"
  mkdir -p "$LOGDIR"
  local log; log="$LOGDIR/connector-$(date -u +%Y%m%dT%H%M%SZ).log"
  echo ">> go test -tags 'lab windowslab' -run '^TestWindowsLab' ./internal/connector/ad/ against dc1 over LDAPS; log: $log"
  ( cd "$HERE/../.." && LAB_TARGET=windows "$GO" test -count=1 -v -tags 'lab windowslab' -run '^TestWindowsLab' ./internal/connector/ad/ ) 2>&1 | tee "$log"
  return "${PIPESTATUS[0]}"
}

# Anything that talks to dc1 runs under the dc1 lock (T-0839, runbook section 10): re-exec under the wrapper.
# The libvirt-only subcommands (up/reset/down/destroy) manage local VMs, not the shared Proxmox dc1.
if [ "${1:-}" = test-connector ] && [ -z "${DIQ_DC1_LOCK_HELD:-}" ]; then
  exec "$HERE/bin/with-dc1-lock" -- "$0" "$@"
fi
if [ "$MODE" = external ]; then
  case "${1:-}" in
    up|reset|down|destroy) die "'$1' manages local libvirt VMs; in external mode the VM is operated by a human (Proxmox). See the runbook.";;
    preflight) for t in openssl go; do command -v "$t" >/dev/null 2>&1 || [ "$t" = go ] || die "missing: $t"; done; check_external && echo "preflight ok (external)"; exit 0;;
  esac
fi
case "${1:-}" in
  preflight) preflight && echo "preflight ok";;
  up) up;; reset) reset;; down) down;; destroy) destroy;; status) status;; info) info;;
  test-connector) test_connector;;
  *) echo "usage: windows-lab {preflight|up|reset|down|destroy|status|info|test-connector}" >&2; exit 2;;
esac
