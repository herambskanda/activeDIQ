#!/usr/bin/env python3
"""Check or restore the LDAP policy the Windows lab proofs depend on, on the lab DC dc1 (T-1265).

  dc1-policy check     read LDAPServerIntegrity and LdapEnforceChannelBindingTokens over WinRM and do a cleartext simple bind to
                       389 with a dummy password. Exit 0 only when both values are 2 and the bind answers 8 (strongerAuthRequired).
                       Otherwise exit 3 and name each value read. Writes nothing. Proofs call this before testing.
  dc1-policy restore   write both values to 2 when they are not, reboot dc1 (channel binding is read at boot) and wait for NTDS,
                       then run `check`. Exit 0 only if it passes.

Wrap every call in the shared lock:  lab/windows/bin/with-dc1-lock lab/windows/bin/dc1-policy check
Lab DC only (A-0025). Needs: pip install pywinrm requests-ntlm. Credentials come from WIN_LAB_ENV and are never printed.
Runbook: knowledge/development/runbooks/windows-lab.md section 18.
"""
import os, sys, time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import dc1policy, dc1winrm


def check(ps, addr, say=print):
    """-> list of problems (empty = enforced). Reads the registry and probes the wire; both must agree."""
    values = dc1policy.parse_policy(ps(dc1policy.READ_PS)[1])
    for k in dc1policy.REQUIRED:
        say(f"{k} = {'(absent)' if values.get(k) is None else values[k]}")
    bad = dc1policy.problems(values)
    try:
        code, name = dc1policy.bind_probe(addr)
        say(f"cleartext simple bind to {addr}:389 with a dummy password -> resultCode {code} ({name})")
        if code != 8:
            bad.append(f"cleartext simple bind answered {code} ({name}), need 8 (strongerAuthRequired)")
    except (OSError, ValueError) as e:
        bad.append(f"bind probe to {addr}:389 failed: {e}")
    return bad


def wait_for_dc(ps, tries=90):
    time.sleep(60)
    for _ in range(tries):
        try:
            if "NTDS Running" in ps("Get-Service NTDS,KDC | % { $_.Name+' '+$_.Status }")[1]:
                return True
        except Exception:
            pass
        time.sleep(10)
    return False


def restore(ps, addr, say=print):
    say("before:")
    before = dc1policy.parse_policy(ps(dc1policy.READ_PS)[1])
    for k in dc1policy.REQUIRED:
        say(f"  {k} = {'(absent)' if before.get(k) is None else before[k]}")
    if dc1policy.problems(before):
        ps(dc1policy.WRITE_PS)
        say("wrote LDAPServerIntegrity=2 and LdapEnforceChannelBindingTokens=2; rebooting dc1 (channel binding is read at boot)")
        ps("Start-Process shutdown -ArgumentList '/r','/t','5','/c','T-1265 restore LDAP signing and channel binding policy'")
        if not wait_for_dc(ps):
            sys.exit("dc1-policy: dc1 did not come back after the reboot")
    else:
        say("already at 2/2; nothing written, no reboot")
    say("after:")
    return check(ps, addr, lambda m: say("  " + m))


def main(argv):
    if len(argv) != 2 or argv[1] not in ("check", "restore"):
        sys.exit(__doc__)
    env, _, addr = dc1winrm.load_env("dc1-policy")
    ps = dc1winrm.make_ps(env, addr)
    bad = check(ps, addr) if argv[1] == "check" else restore(ps, addr)
    if bad:
        print("dc1-policy: NOT ENFORCED: " + "; ".join(bad), file=sys.stderr)
        sys.exit(3)
    print("dc1-policy: enforced (LDAPServerIntegrity=2, LdapEnforceChannelBindingTokens=2, cleartext bind refused with 8)")


if __name__ == "__main__":
    main(sys.argv)
