{
  "id": "usr-07",
  "version": 1,
  "category": "users",
  "title": "Sign-in and access settings",
  "description": "Dial-in permission, smart card requirement and logon-hour restrictions of users, read from the attributes the sync stored. Dial-in has three states: allow, deny, and no value, where network policy (NPS) decides; users with no value are counted in the header and never listed as Deny. Smart card required is the userAccountControl flag, not proof of a certificate. Logon hours are stored per whole UTC hour, Sunday 00:00 first; a user with no value is unrestricted.",
  "dataset": "inventory.users",
  "columns": [
    "display_name",
    "sam_account_name",
    "domain",
    "dn",
    "dialin_allowed",
    "enabled"
  ],
  "sort": [
    {
      "column": "sam_account_name",
      "dir": "asc"
    }
  ],
  "caveats": [
    "ou_path_is_dn",
    "user_attribute_absent_or_unread"
  ],
  "presets": [
    {
      "id": "dialin_allow",
      "names": [
        "Dial-in Allow Access"
      ],
      "where": {
        "cmp": {
          "col": "dialin_allowed",
          "op": "eq",
          "value": {
            "bool": true
          }
        }
      }
    },
    {
      "id": "dialin_deny",
      "names": [
        "Dial-in Deny Access"
      ],
      "where": {
        "or": [
          {
            "cmp": {
              "col": "dialin_allowed",
              "op": "eq",
              "value": {
                "bool": false
              }
            }
          },
          {
            "cmp": {
              "col": "dialin_allowed",
              "op": "absent"
            }
          }
        ]
      },
      "hidden": [
        {
          "id": "nps_controlled",
          "label": "users controlled by network policy (NPS): no dial-in value set",
          "where": {
            "cmp": {
              "col": "dialin_allowed",
              "op": "absent"
            }
          }
        }
      ]
    },
    {
      "id": "smartcard",
      "names": [
        "Smart Card Enabled Users"
      ],
      "where": {
        "cmp": {
          "col": "smartcard_required",
          "op": "eq",
          "value": {
            "bool": true
          }
        }
      },
      "columns": [
        "display_name",
        "sam_account_name",
        "domain",
        "dn",
        "smartcard_required",
        "password_state",
        "enabled"
      ]
    },
    {
      "id": "logon_hours",
      "names": [
        "Logon Hour Based Report"
      ],
      "where": {
        "cmp": {
          "col": "logon_hours_restricted",
          "op": "eq",
          "value": {
            "bool": true
          }
        }
      },
      "columns": [
        "display_name",
        "sam_account_name",
        "domain",
        "dn",
        "logon_hours",
        "enabled"
      ]
    }
  ]
}
